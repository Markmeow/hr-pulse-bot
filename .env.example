# ============================================================
#  Internship Assistant Bot - Environment Variables
#  Copy this file to ".env" and fill in your own values.
# ============================================================

# Your bot token from the Discord Developer Portal
# (Applications -> Your App -> Bot -> Reset/Copy Token)
DISCORD_TOKEN=your-bot-token-here

# Your application's Client ID
# (Applications -> Your App -> General Information -> Application ID)
CLIENT_ID=your-application-client-id-here

# The server (guild) ID where slash commands are registered for development.
# Right-click your server icon -> Copy Server ID (requires Developer Mode).
# Guild commands appear instantly. Leave blank to register commands globally
# (global commands can take up to ~1 hour to show up).
GUILD_ID=your-server-id-here

# Channel ID where daily standup summaries are posted.
# Right-click a channel -> Copy Channel ID (requires Developer Mode).
# If left blank, the standup summary is posted in the channel where /standup was run.
STANDUP_CHANNEL_ID=

# Channel ID สำหรับระบบยืนยันตัวตน (Auth Panel)
AUTH_CHANNEL_ID=1514471818222764032

# Path to the SQLite database file (optional). Defaults to ./data/bot.db
# DATABASE_PATH=./data/bot.db
